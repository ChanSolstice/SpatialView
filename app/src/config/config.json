{
  "config_version": 1,
  "server": {
    "rosbridge_url": "ws://192.168.1.10:9090",
    "http_base_url": "http://192.168.1.10:8080"
  },
  "timing": {
    "state_timeout_ms": 3000,
    "reconnect_interval_ms": 2000,
    "service_timeout_ms": 5000,
    "estop_timeout_ms": 1000
  },
  "robot": {
    "urdf": "robot/aubo_i5H_dev.urdf",
    "packages": { "aubo_description": "robot/aubo_description" },
    "joint_name_map": {}
  },
  "scene": {
    "default_view_direction": [1.0, -1.0, 0.8],
    "default_target": [0.5, 0.0, 0.2],
    "tap_threshold_px": 8,
    "zoom_min_ratio": 0.3,
    "zoom_max_ratio": 6.0,
    "path_arrow_spacing_m": 0.16,
    "grid_size_m": 4.0,
    "grid_cell_m": 0.1
  },
  "animation": { "speeds": [1, 5, 20] }
}
