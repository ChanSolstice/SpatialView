    "test:watch": "vitest",
    "test:contract": "vitest run tests/interface.contract.test.ts"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "roslib": "2.1.0",
    "three": "0.160.0",
    "urdf-loader": "0.12.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
